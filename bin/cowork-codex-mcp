#!/bin/sh
set -eu

PLUGIN_ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)

if command -v node >/dev/null 2>&1; then
  NODE_BIN=$(command -v node)
else
  NODE_BIN=""
  for candidate in /opt/homebrew/bin/node /usr/local/bin/node /usr/bin/node; do
    if [ -x "$candidate" ]; then
      NODE_BIN=$candidate
      break
    fi
  done
fi

if [ -z "$NODE_BIN" ]; then
  echo "cowork-codex: node was not found on PATH or common macOS install paths" >&2
  exit 127
fi

exec "$NODE_BIN" "$PLUGIN_ROOT/servers/cowork-codex-mcp.mjs"
